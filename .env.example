# Copy to .env.local and fill in. For a local stack, take the values from `supabase status`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Keep Cleanverse secrets out of this browser file. Set these as Supabase Edge
# Function secrets for the server-only provider adapter:
# CLEANVERSE_ENVIRONMENT=sandbox
# CLEANVERSE_API_ID=
# CLEANVERSE_API_KEY=
